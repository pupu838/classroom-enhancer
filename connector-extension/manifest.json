{
  "manifest_version": 3,
  "name": "西农课堂连接器",
  "version": "0.4.1",
  "description": "使用学校当前登录读取课程与回放，在浏览器内提取原始音轨。",
  "content_scripts": [
    {
      "matches": [
        "https://ylb.nwafu.edu.cn/TeachingCenterStudentWeb/*"
      ],
      "js": [
        "connector.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}