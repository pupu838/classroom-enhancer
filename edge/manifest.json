{
  "manifest_version": 3,
  "name": "西农云课堂增强",
  "version": "0.3.0",
  "description": "全屏可调字幕、本地人声增强与底噪采样降噪（试用版）",
  "content_scripts": [
    {
      "matches": [
        "https://ylb.nwafu.edu.cn/TeachingCenterStudentWeb/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "denoise-worklet.js"
      ],
      "matches": [
        "https://ylb.nwafu.edu.cn/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:11434/*"
  ]
}