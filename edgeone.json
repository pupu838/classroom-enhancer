{
  "buildCommand": "python build.py && node scripts/build-tablet.mjs",
  "outputDirectory": "portal",
  "cloudFunctions": {
    "maxDuration": 120
  },
  "overseasRegions": [
    "ap-singapore"
  ],
  "headers": [
    {
      "source": "/moss-check.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/moss-check-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/tablet/vendor/*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}